# Copy to .env. Generate secrets with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
RESIDENCY_JOIN_CODE=replace-with-a-long-random-invitation-code
RESIDENCY_ORIGIN=http://127.0.0.1:7340
RESIDENCY_SECURE_COOKIES=false
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT=90
# Optional: pin an exact tested image digest before deploying.
HERMES_IMAGE=nousresearch/hermes-agent:stable
